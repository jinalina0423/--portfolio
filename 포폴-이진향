<script>
(() => {
  "use strict";

  /* 모바일 메뉴 */
  const menuButton = document.querySelector("#menuButton");
  const siteNav = document.querySelector("#siteNav");

  function closeMenu() {
    siteNav.dataset.open = "false";
    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "메뉴 열기");
  }

  menuButton.addEventListener("click", () => {
    const open = siteNav.dataset.open !== "true";
    siteNav.dataset.open = String(open);
    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
  });

  siteNav.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("click", event => {
    if (
      siteNav.dataset.open === "true" &&
      !siteNav.contains(event.target) &&
      !menuButton.contains(event.target)
    ) closeMenu();
  });

  /* 프로젝트 상세 보기 */
  const dialog = document.querySelector("#projectDialog");
  const dialogTitle = document.querySelector("#dialogTitle");
  const dialogKicker = document.querySelector("#dialogKicker");
  const dialogContent = document.querySelector("#dialogContent");
  const dialogClose = document.querySelector("#dialogClose");

  const projectNames = {
    dashboard: "에너지 사용 데이터 인사이트 대시보드",
    solar: "태양광 발전량과 수요 비교 분석",
    campus: "캠퍼스 에너지 절감 참여 프로젝트"
  };

  let lastTrigger = null;

  document.querySelectorAll("[data-detail]").forEach(button => {
    button.addEventListener("click", () => {
      const key = button.dataset.detail;
      const template = document.querySelector("#detail-" + key);

      if (!template || !projectNames[key]) return;

      lastTrigger = button;
      dialogTitle.textContent = projectNames[key];
      dialogKicker.textContent =
        "PROJECT " + (Object.keys(projectNames).indexOf(key) + 1) + " / DETAIL";

      dialogContent.replaceChildren(template.content.cloneNode(true));

      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }

      dialogClose.focus();
    });
  });

  function closeDialog() {
    if (typeof dialog.close === "function" && dialog.open) {
      dialog.close();
    } else {
      dialog.removeAttribute("open");
    }
  }

  dialogClose.addEventListener("click", closeDialog);

  dialog.addEventListener("click", event => {
    if (event.target === dialog) closeDialog();
  });

  dialog.addEventListener("close", () => {
    if (lastTrigger) lastTrigger.focus();
  });

  /* 작업실 움직임 */
  const scene = document.querySelector("#sceneMotion");
  const motionButton = document.querySelector("#motionToggle");
  const motionStatus = document.querySelector("#motionStatus");

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );

  const finePointer = window.matchMedia(
    "(hover: hover) and (pointer: fine)"
  );

  let paused = reducedMotion.matches;
  let frameId = null;
  let previousTime = null;
  let elapsed = 0;

  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;

  let targetScroll = 0;
  let currentScroll = 0;
  let currentTilt = 0;

  function updateMotionButton() {
    motionButton.textContent = paused
      ? "움직임 켜기"
      : "움직임 멈추기";

    motionButton.setAttribute(
      "aria-pressed",
      String(!paused)
    );

    motionStatus.textContent = paused
      ? "작업실 그림의 움직임이 정지되어 있습니다."
      : "작업실 그림의 움직임이 재생 중입니다.";
  }

  function stopLoop() {
    if (frameId !== null) {
      cancelAnimationFrame(frameId);
      frameId = null;
    }
    previousTime = null;
  }

  function schedule() {
    if (paused || document.hidden || frameId !== null) return;
    frameId = requestAnimationFrame(animate);
  }

  function animate(timestamp) {
    frameId = null;

    if (paused || document.hidden) return;

    const delta = previousTime === null
      ? 0
      : Math.min(timestamp - previousTime, 40);

    previousTime = timestamp;
    elapsed += delta;

    /* 약 7초 주기, 상하 5px */
    const floatY = Math.sin(
      elapsed / 7000 * Math.PI * 2
    ) * 5;

    /* 부드러운 보간 */
    const easing = 1 - Math.exp(-delta / 180);

    currentX += (targetX - currentX) * easing;
    currentY += (targetY - currentY) * easing;
    currentScroll += (targetScroll - currentScroll) * easing;

    /* 기울기 최대 4도 */
    const tiltTarget = finePointer.matches
      ? Math.max(-4, Math.min(4, currentX * .5 - currentY * .15))
      : 0;

    currentTilt += (tiltTarget - currentTilt) * easing;

    scene.style.transform =
      `translate3d(${currentX}px, ${floatY + currentY + currentScroll}px, 0) ` +
      `rotate(${currentTilt}deg)`;

    schedule();
  }

  /* PC 마우스 추적 */
  scene.addEventListener("pointermove", event => {
    if (!finePointer.matches || paused) return;

    const rect = scene.getBoundingClientRect();

    if (!rect.width || !rect.height) return;

    const x = ((event.clientX - rect.left) / rect.width - .5) * 2;
    const y = ((event.clientY - rect.top) / rect.height - .5) * 2;

    targetX = Math.max(-1, Math.min(1, x)) * 7;
    targetY = Math.max(-1, Math.min(1, y)) * 4;
  });

  scene.addEventListener("pointerleave", () => {
    targetX = 0;
    targetY = 0;
  });

  /* 스크롤 시 위로 최대 20px */
  window.addEventListener("scroll", () => {
    targetScroll = -Math.min(window.scrollY * .035, 20);
  }, { passive: true });

  /* 움직임 정지 버튼 */
  motionButton.addEventListener("click", () => {
    paused = !paused;

    if (paused) {
      stopLoop();
      scene.style.transform = "translate3d(0,0,0) rotate(0deg)";
      currentX = currentY = currentScroll = currentTilt = 0;
      targetX = targetY = 0;
    } else {
      schedule();
    }

    updateMotionButton();
  });

  /* 숨겨진 탭에서 애니메이션 정지 */
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      stopLoop();
    } else {
      previousTime = null;
      schedule();
    }
  });

  /* 움직임 감소 설정 */
  reducedMotion.addEventListener("change", event => {
    if (event.matches) {
      paused = true;
      stopLoop();
      scene.style.transform = "translate3d(0,0,0) rotate(0deg)";
      currentX = currentY = currentScroll = currentTilt = 0;
    }

    updateMotionButton();

    if (!paused) schedule();
  });

  finePointer.addEventListener("change", () => {
    targetX = targetY = 0;
  });

  updateMotionButton();

  if (!paused) schedule();

})();
</script>

</body>
</html>
