
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f5f0e5">
<title>이진향 | 경영 포트폴리오</title>

<style>
:root {
  --cream: #f5f0e5;
  --paper: #fffdf8;
  --green: #183f34;
  --green2: #285b49;
  --sage: #e9eee4;
  --ink: #26362f;
  --muted: #718075;
  --line: #ded8ca;
  --gold: #d7a86e;
  --shadow: 0 18px 45px rgba(37,57,44,.10);
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: "Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
  line-height: 1.7;
  letter-spacing: -.025em;
}

a { color: inherit; text-decoration: none; }
button { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }

button:focus-visible,
a:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 4px;
}

.container {
  width: min(1120px, calc(100% - 44px));
  margin: auto;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(245,240,229,.92);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(24,63,52,.08);
}

.nav {
  min-height: 74px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--green);
  font-weight: 900;
  white-space: nowrap;
}

.brand-mark {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  background: var(--green);
  color: white;
  border-radius: 12px 12px 12px 4px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 25px;
}

.nav-links a {
  font-size: 13px;
  font-weight: 700;
  color: #526057;
}

.nav-links a:hover { color: var(--green2); }

.nav-contact {
  padding: 9px 15px;
  background: var(--green);
  color: white !important;
  border-radius: 30px;
}

.menu-button {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--paper);
  color: var(--green);
  cursor: pointer;
}

.hero { padding: 75px 0 80px; }

.hero-grid {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  gap: 40px;
}

.eyebrow {
  color: var(--green2);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .13em;
  margin-bottom: 18px;
}

h1 {
  margin: 0 0 22px;
  color: var(--green);
  font-size: clamp(40px, 5.5vw, 66px);
  line-height: 1.15;
  letter-spacing: -.065em;
}

h1 span { color: var(--green2); }

.hero-text {
  color: #5e6b61;
  font-size: 15px;
  line-height: 1.95;
  max-width: 550px;
  word-break: keep-all;
}

.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 25px 0;
}

.pill {
  padding: 6px 12px;
  border: 1px solid #d9dfd4;
  border-radius: 30px;
  color: var(--green2);
  background: rgba(255,253,248,.8);
  font-size: 12px;
  font-weight: 700;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 11px 18px;
  border: 1px solid transparent;
  border-radius: 13px;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  transition: .2s;
}

.button:hover { transform: translateY(-2px); }

.primary {
  background: var(--green);
  color: white;
  box-shadow: 0 8px 18px rgba(24,63,52,.16);
}

.secondary {
  background: var(--paper);
  color: var(--green);
  border-color: var(--line);
}

/* 작업실 일러스트 */
.scene-column { min-width: 0; }

.scene-motion {
  width: 100%;
  max-width: 510px;
  margin: auto;
  transform: translate3d(0,0,0);
  transform-origin: 50% 56%;
  will-change: transform;
  touch-action: pan-y;
}

.workroom {
  width: 100%;
  height: auto;
  display: block;
}

.scene-caption {
  max-width: 390px;
  margin: 10px auto 0;
  text-align: center;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.motion-controls {
  display: flex;
  justify-content: center;
  margin-top: 13px;
}

.motion-toggle {
  padding: 8px 13px;
  border: 1px solid var(--line);
  border-radius: 30px;
  background: var(--paper);
  color: var(--green2);
  font-size: 12px;
  font-weight: 750;
  cursor: pointer;
}

.motion-status {
  margin: 7px 0 0;
  text-align: center;
  font-size: 10px;
  color: var(--muted);
}

/* 공통 섹션 */
.content-section { padding: 80px 0; }

.paper-section {
  background: rgba(255,253,248,.65);
  border-block: 1px solid rgba(24,63,52,.06);
}

.section-heading {
  max-width: 650px;
  margin-bottom: 35px;
}

.kicker {
  display: block;
  margin-bottom: 10px;
  color: #6d927b;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .15em;
}

h2 {
  margin: 0 0 13px;
  color: var(--green);
  font-size: clamp(29px, 3.5vw, 40px);
  line-height: 1.25;
  letter-spacing: -.055em;
}

.section-description {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.9;
  word-break: keep-all;
}

/* 소개 */
.about-panel {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 25px;
  padding: 30px;
  border: 1px solid #e6dfd1;
  border-radius: 28px;
  background: var(--paper);
  box-shadow: var(--shadow);
}

.about-copy {
  color: #5f6d63;
  font-size: 14px;
  line-height: 2;
  word-break: keep-all;
}

.about-aside {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24px;
  border-radius: 20px;
  background: #f0f2e9;
}

.about-aside strong {
  color: var(--green);
  margin-bottom: 8px;
}

.about-aside p {
  margin: 0;
  color: #68766b;
  font-size: 13px;
}

/* 프로젝트 */
.project-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.project-card {
  display: flex;
  flex-direction: column;
  min-height: 320px;
  padding: 23px;
  border: 1px solid #e5dfd2;
  border-radius: 22px;
  background: var(--paper);
  box-shadow: 0 9px 28px rgba(37,57,44,.055);
  transition: transform .2s, box-shadow .2s;
}

.project-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
}

.project-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}

.project-number {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  background: var(--sage);
  color: var(--green);
  border-radius: 14px;
  font-weight: 900;
}

.project-type {
  color: #849087;
  font-size: 10px;
  font-weight: 800;
}

.project-card h3 {
  color: var(--green);
  font-size: 19px;
  line-height: 1.45;
  margin: 0 0 10px;
}

.project-card p {
  color: #6c786f;
  font-size: 12px;
  line-height: 1.85;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  margin-bottom: 18px;
}

.tag {
  padding: 5px 9px;
  background: #f0f3eb;
  color: #55705d;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 750;
}

.detail-button {
  width: fit-content;
  padding: 0;
  border: 0;
  background: none;
  color: var(--green2);
  font-size: 12px;
  font-weight: 850;
  cursor: pointer;
}

.notice {
  margin-top: 22px;
  padding: 14px 17px;
  border-radius: 12px;
  background: #f0eee5;
  color: #778177;
  font-size: 11px;
  line-height: 1.8;
}

/* 역량 */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.skill-card {
  padding: 22px;
  border: 1px solid #e5dfd2;
  border-radius: 19px;
  background: var(--paper);
}

.skill-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  margin-bottom: 17px;
  border-radius: 14px;
  background: var(--sage);
  color: var(--green2);
  font-size: 20px;
}

.skill-card h3 {
  color: var(--green);
  font-size: 15px;
  margin: 0 0 8px;
}

.skill-card p {
  color: #748076;
  font-size: 12px;
  line-height: 1.8;
  margin: 0;
}

/* 활동 기록 */
.timeline {
  max-width: 800px;
  margin: auto;
}

.timeline-item {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 25px;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
}

.timeline-date {
  color: var(--green2);
  font-size: 13px;
  font-weight: 900;
}

.timeline-content h3 {
  margin: 0 0 8px;
  color: var(--green);
  font-size: 17px;
}

.timeline-content p {
  margin: 0;
  color: #718075;
  font-size: 13px;
  line-height: 1.9;
}

/* 연락처 */
.contact-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 38px;
  border-radius: 27px;
  background: var(--green);
  color: white;
}

.contact-panel h2 { color: white; }

.contact-panel p {
  color: #d0ddd2;
  font-size: 13px;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 13px 17px;
  border-radius: 13px;
  background: #fffdf8;
  color: var(--green);
  font-size: 13px;
  font-weight: 850;
  white-space: nowrap;
}

footer {
  padding: 25px 0;
  color: #899188;
  font-size: 11px;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

/* 프로젝트 상세 */
dialog {
  width: min(600px, calc(100% - 30px));
  max-height: 85vh;
  overflow-y: auto;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 23px;
  background: var(--paper);
  color: var(--ink);
  box-shadow: 0 25px 80px rgba(0,0,0,.22);
}

dialog::backdrop {
  background: rgba(18,35,28,.55);
  backdrop-filter: blur(4px);
}

.dialog-inner { padding: 28px; }

.dialog-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.dialog-kicker {
  margin: 0 0 7px;
  color: #6d927b;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.dialog-top h2 {
  font-size: 23px;
  margin: 0;
}

.dialog-close {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: white;
  color: var(--green);
  cursor: pointer;
}

.detail-section { padding-top: 20px; }

.detail-section h3 {
  margin: 0 0 9px;
  color: var(--green);
  font-size: 15px;
}

.detail-section p,
.detail-section li {
  color: #6c786f;
  font-size: 13px;
  line-height: 1.9;
}

.detail-section ul { padding-left: 20px; }

/* 모바일 */
@media (max-width: 850px) {
  .hero { padding: 55px 0; }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .hero-copy { order: 1; }
  .scene-column { order: 2; }

  .scene-motion { max-width: 480px; }

  .project-grid { grid-template-columns: 1fr 1fr; }
  .skills-grid { grid-template-columns: 1fr 1fr; }

  .nav-links {
    display: none;
    position: absolute;
    top: 74px;
    left: 0;
    right: 0;
    padding: 18px 22px 22px;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }

  .nav-links[data-open="true"] { display: flex; }

  .nav-links a { padding: 13px 5px; }

  .nav-contact {
    text-align: center;
    margin-top: 8px;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
}

@media (max-width: 560px) {
  .container { width: calc(100% - 32px); }

  .hero { padding: 42px 0 50px; }
  h1 { font-size: 42px; }
  .hero-text { font-size: 14px; }

  .content-section { padding: 60px 0; }

  .about-panel {
    grid-template-columns: 1fr;
    padding: 22px;
  }

  .project-grid { grid-template-columns: 1fr; }
  .project-card { min-height: 280px; }

  .skills-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  .skill-card { padding: 17px; }

  .timeline-item {
    grid-template-columns: 65px 1fr;
    gap: 15px;
  }

  .contact-panel {
    align-items: flex-start;
    flex-direction: column;
    padding: 25px;
  }

  .contact-link {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .footer-inner { flex-direction: column; }
  .dialog-inner { padding: 22px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }

  *, *::before, *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
</style>
</head>

<body>

<header>
  <div class="container nav">
    <a class="brand" href="#home">
      <span class="brand-mark">J</span>
      <span>LEE JIN HYANG</span>
    </a>

    <nav class="nav-links" id="siteNav" data-open="false">
      <a href="#about">소개</a>
      <a href="#projects">프로젝트</a>
      <a href="#skills">역량</a>
      <a href="#activities">활동 기록</a>
      <a class="nav-contact" href="#contact">연락하기 ↗</a>
    </nav>

    <button class="menu-button" id="menuButton"
      aria-label="메뉴 열기" aria-expanded="false">☰</button>
  </div>
</header>

<main>
<section class="hero" id="home">
  <div class="container hero-grid">

    <div class="hero-copy">
      <p class="eyebrow">BUSINESS · DATA · ENERGY</p>

      <h1>
        데이터를 이해하고<br>
        <span>가치를 연결하는</span><br>
        이진향입니다.
      </h1>

      <p class="hero-text">
        안녕하세요. 가톨릭대학교 경영학과에 재학 중인 이진향입니다.
        경영의 관점으로 문제를 분석하고, 데이터를 바탕으로
        실행 가능한 아이디어를 만드는 데 관심이 있습니다.
        모아빛에너지에서 에너지와 비즈니스를 연결하는
        경험을 쌓고 싶습니다.
      </p>

      <div class="pills">
        <span class="pill">가톨릭대학교 경영학과</span>
        <span class="pill">교내 캡스톤 경진대회</span>
        <span class="pill">모아빛에너지 지원</span>
      </div>

      <div class="actions">
        <a class="button primary" href="#projects">프로젝트 보기 ↗</a>
        <a class="button secondary" href="#contact">연락하기</a>
      </div>
    </div>

    <div class="scene-column">
      <div class="scene-motion" id="sceneMotion">

        <svg class="workroom" viewBox="0 0 520 430"
          xmlns="http://www.w3.org/2000/svg"
          role="img" aria-labelledby="sceneTitle sceneDesc">

          <title id="sceneTitle">데이터 작업실 일러스트</title>
          <desc id="sceneDesc">
            둥근 캐릭터가 나무 책상 앞에서 듀얼 모니터를 살펴봅니다.
            책상 위에는 머그컵과 식물이 놓여 있습니다.
          </desc>

          <defs>
            <linearGradient id="wall" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#fffdf8"/>
              <stop offset="1" stop-color="#e9eee4"/>
            </linearGradient>

            <linearGradient id="desk" x1="0" y1="0" x2="0" y2="1">
              <stop stop-color="#d9b98c"/>
              <stop offset="1" stop-color="#b98b5d"/>
            </linearGradient>

            <linearGradient id="screen" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#285b49"/>
              <stop offset="1" stop-color="#183f34"/>
            </linearGradient>

            <linearGradient id="character" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#fffdf8"/>
              <stop offset="1" stop-color="#e5e9dc"/>
            </linearGradient>

            <filter id="shadow" x="-30%" y="-30%" width="160%" height="170%">
              <feDropShadow dx="0" dy="12" stdDeviation="12"
                flood-color="#315342" flood-opacity=".14"/>
            </filter>
          </defs>

          <rect x="25" y="20" width="470" height="365"
            rx="45" fill="url(#wall)"/>

          <circle cx="420" cy="75" r="42" fill="#e4e9dc"/>
          <circle cx="420" cy="75" r="28" fill="#f5f0e5"/>

          <!-- 창문 -->
          <rect x="55" y="52" width="130" height="112"
            rx="18" fill="#dfe9df"/>
          <rect x="65" y="62" width="110" height="92"
            rx="12" fill="#f7faf2"/>
          <path d="M120 62v92M65 108h110"
            stroke="#c5d5c5" stroke-width="5"/>

          <!-- 식물 -->
          <g transform="translate(75 115)">
            <path d="M25 25C-5 5 0-15 22-8C35 0 30 16 25 25Z"
              fill="#8ba98b"/>
            <path d="M27 26C20-5 42-18 50 0C52 12 39 22 27 26Z"
              fill="#6d927b"/>
            <path d="M26 27C-2 18-10 35 5 44C17 46 23 37 26 27Z"
              fill="#a9bea2"/>
            <path d="M18 30h22l-4 27H22Z" fill="#d6a779"/>
            <path d="M17 30h24" stroke="#b98252" stroke-width="4"/>
          </g>

          <ellipse cx="265" cy="365" rx="190" ry="25"
            fill="#c8d1c2" opacity=".5"/>

          <g filter="url(#shadow)">

            <!-- 왼쪽 모니터 -->
            <rect x="105" y="145" width="145" height="105"
              rx="13" fill="#d8ddd2"/>
            <rect x="113" y="153" width="129" height="88"
              rx="8" fill="url(#screen)"/>

            <path d="M128 215h98M128 190h98M128 165h98"
              stroke="#6f9277" stroke-width="1.5" opacity=".5"/>
            <path d="M130 220l22-25 20 10 24-29 24 12"
              fill="none" stroke="#e7c28f" stroke-width="4"
              stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="196" cy="176" r="4" fill="#e7c28f"/>

            <!-- 오른쪽 모니터 -->
            <rect x="270" y="145" width="145" height="105"
              rx="13" fill="#d8ddd2"/>
            <rect x="278" y="153" width="129" height="88"
              rx="8" fill="url(#screen)"/>

            <rect x="290" y="166" width="48" height="25"
              rx="5" fill="#f5f0e5" opacity=".9"/>
            <rect x="345" y="166" width="48" height="25"
              rx="5" fill="#d7a86e" opacity=".9"/>

            <path d="M292 222v-17h13v17m8 0v-29h13v29m8 0v-22h13v22"
              fill="#a9bea2"/>

            <path d="M175 250v25m-20 0h40"
              stroke="#aab5a7" stroke-width="8" stroke-linecap="round"/>
            <path d="M340 250v25m-20 0h40"
              stroke="#aab5a7" stroke-width="8" stroke-linecap="round"/>

            <!-- 둥근 캐릭터 -->
            <g>
              <ellipse cx="260" cy="265" rx="62" ry="57"
                fill="url(#character)" stroke="#d9dfd4" stroke-width="3"/>

              <ellipse cx="239" cy="259" rx="5" ry="7" fill="#365346"/>
              <ellipse cx="281" cy="259" rx="5" ry="7" fill="#365346"/>

              <path d="M250 276q10 10 20 0"
                fill="none" stroke="#b98270" stroke-width="3"
                stroke-linecap="round"/>

